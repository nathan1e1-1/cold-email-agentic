# Copy to `.env` and fill in. Never commit `.env`.
# Google OAuth "Desktop app" client (see docs/setup.md).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765

# AI provider for drafting. `groq` (default) or `gemini`.
VITE_AI_PROVIDER=groq
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=

# Mail provider. `gmail` (default) or `outlook`.
# Outlook uses a public client (no secret); see docs/setup-outlook.md.
# These are first-run fallbacks; settings saved in the app win.
VITE_MAIL_PROVIDER=gmail
VITE_OUTLOOK_CLIENT_ID=
# Single-tenant Entra apps must use their Directory (tenant) ID or domain here.
# `common`/`organizations` apply only to multi-tenant registrations.
VITE_OUTLOOK_TENANT=common
VITE_OUTLOOK_REDIRECT_URI=http://localhost:8766
